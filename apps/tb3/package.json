{
  "name": "@synth-editors/tb3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:browser": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "e2e": "vite build && playwright test",
    "e2e:hw": "vite build && TB3_HW=1 playwright test",
    "guide:shots": "vite build && playwright test -c playwright.guide.config.ts",
    "package": "vite build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@synth-editors/audio": "*",
    "@synth-editors/cc-learn": "*",
    "@synth-editors/launchpad": "*",
    "@synth-editors/midi": "*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  },
  "description": "Editor and patch librarian for the Roland TB-3",
  "author": "BC Modular",
  "build": {
    "appId": "com.bcmodular.tb3editor",
    "productName": "TB-3 Editor",
    "artifactName": "TB-3-Editor-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist/**",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "TB-3 Editor listens to the TB-3's USB audio to show its waveform and level."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
