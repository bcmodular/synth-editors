{
  "name": "synth-editors",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:tb3": "npm run dev -w @synth-editors/tb3",
    "test": "vitest run",
    "test:e2e": "npm run e2e -w @synth-editors/tb3",
    "test:tb3": "npm run e2e:hw -w @synth-editors/tb3",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package:tb3": "npm run package -w @synth-editors/tb3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
